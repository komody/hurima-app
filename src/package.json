{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "format": "prettier --write \"resources/**/*.{js,jsx,ts,tsx,vue,css,scss,json}\"",
        "format:check": "prettier --check \"resources/**/*.{js,jsx,ts,tsx,vue,css,scss,json}\""
    },
    "devDependencies": {
        "axios": "^0.21",
        "laravel-mix": "^6.0.6",
        "lodash": "^4.17.19",
        "postcss": "^8.1.14",
        "prettier": "^3.8.1",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.32.0",
        "sass-loader": "^10.1.1"
    }
}
